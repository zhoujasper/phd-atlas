{
  "name": "phd-atlas",
  "private": true,
  "version": "0.1.0-beta.7",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:full",
    "dev:web": "vite",
    "dev:api": "node --watch tools/start-server.mjs",
    "dev:full": "node tools/start-dev.mjs",
    "dev:workers": "concurrently -k \"node --watch tools/start-server.mjs\" \"node tools/wait-for-api.mjs && vite\"",
    "build": "tsc -b && vite build && node tools/stamp-service-worker.mjs",
    "typecheck": "tsc -b --force",
    "lint": "oxlint",
    "i18n:check": "node tools/check-i18n.mjs && node tools/check-ui-i18n.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "start": "node tools/start-server.mjs",
    "build:update-package": "node tools/build-update-package.mjs",
    "release:notes:check": "node tools/extract-release-notes.mjs --check",
    "verify:contracts": "node tools/release-preflight.mjs contracts",
    "verify:tree": "node tools/release-preflight.mjs tree",
    "verify:public": "node tools/release-preflight.mjs public",
    "verify:release": "node tools/release-preflight.mjs release",
    "verify:push": "node tools/release-preflight.mjs push",
    "verify:published-update": "node tools/verify-published-update.mjs",
    "hooks:install": "node tools/install-git-hooks.mjs",
    "verify:discover-adapters": "node tools/verify-discover-school-adapters.mjs",
    "verify:discover-adapters:live": "node tools/verify-discover-school-adapters.mjs --live",
    "security:source": "node tools/security-source-audit.mjs",
    "security:audit": "npm run security:source && npm audit --audit-level=high",
    "seed:stress": "node tools/seed-stress-applications.mjs",
    "qa:stress": "node tools/qa-stress.mjs"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "imapflow": "^1.4.3",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.9.14",
    "morgan": "^1.10.1",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tar-fs": "^2.1.5",
    "unified": "^11.0.5",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/code": "^0.47.0",
    "@lexical/html": "^0.47.0",
    "@lexical/link": "^0.47.0",
    "@lexical/list": "^0.47.0",
    "@lexical/markdown": "^0.47.0",
    "@lexical/react": "^0.47.0",
    "@lexical/rich-text": "^0.47.0",
    "@lexical/selection": "^0.47.0",
    "@playwright/test": "^1.61.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.1",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/textarea-caret": "^3.0.4",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "docx-preview": "^0.3.6",
    "esbuild": "0.28.1",
    "jsdom": "^29.1.1",
    "lexical": "^0.47.0",
    "lucide-react": "^1.22.0",
    "oxlint": "^1.69.0",
    "prettier": "^3.9.6",
    "prismjs": "^1.30.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-simple-code-editor": "^0.14.1",
    "textarea-caret": "^3.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^4.1.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.9.0"
  }
}
